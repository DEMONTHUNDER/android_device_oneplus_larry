service vendor.nfc_hal_service /vendor/bin/hw/android.hardware.nfc-service.nxp
    override
    class early_hal
    user nfc
    group nfc
    disabled

on boot && property:ro.boot.product.hardware.sku=6
    enable vendor.nfc_hal_service

on boot && property:ro.boot.product.hardware.sku=14
    enable vendor.nfc_hal_service
# -------------------------------------------------------------
# Runtime Performance, Memory & UI Responsiveness Tweaks
# -------------------------------------------------------------
on property:sys.boot_completed=1
    # Memory & Paging: Fast zRAM usage to prevent flash storage wait
    write /proc/sys/vm/swappiness 100
    write /proc/sys/vm/vfs_cache_pressure 80
    write /proc/sys/vm/dirty_ratio 20
    write /proc/sys/vm/dirty_background_ratio 5
    write /proc/sys/vm/stat_interval 10

    # CPU Schedutil Governor: Fast frequency ramp-up for touch events
    # Little Cluster (cores 0-5)
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy0/schedutil/down_rate_limit_us 20000

    # Big Cluster (cores 6-7)
    write /sys/devices/system/cpu/cpufreq/policy6/schedutil/up_rate_limit_us 500
    write /sys/devices/system/cpu/cpufreq/policy6/schedutil/down_rate_limit_us 15000

    # Storage I/O Read-Ahead Tuning (Internal UFS)
    write /sys/block/sda/queue/read_ahead_kb 512
    write /sys/block/sdb/queue/read_ahead_kb 512
    write /sys/block/sdc/queue/read_ahead_kb 512
    write /sys/block/sda/queue/iostats 0

    # Reduce Kernel Scheduler Tick Overhead
    write /proc/sys/kernel/sched_schedstats 0
    write /proc/sys/kernel/perf_cpu_time_max_percent 10
